---
import Section from './Section.astro';
import CharactersGallery from '../CharactersGallery.astro';
import SectionLink from '../SectionLink.astro';
import type { CollectionEntry } from 'astro:content';

type BookData = CollectionEntry<'books'>['data'];

interface Props {
  characters: NonNullable<BookData['characters']>;
  folder?: string;
  maps?: BookData['characterMaps'];
}
const { characters, folder, maps } = Astro.props;
---
<Section title="Персонажи">
  <CharactersGallery characters={characters} folder={folder} />
  {maps && maps.length > 0 && (
    <div class="flex flex-wrap gap-3 mt-6">
      {maps.map(m => <SectionLink href={m.url} label={m.label} />)}
    </div>
  )}
</Section>
