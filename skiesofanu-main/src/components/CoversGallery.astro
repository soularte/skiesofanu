---
import { Image } from 'astro:assets';
import MarketplaceLinks from './MarketplaceLinks.astro';
import GalleryArrow from './GalleryArrow.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  covers: {
    src: ImageMetadata;
    title: string;
    slug: string;
    description?: string;
    marketplace?: boolean;
    links?: { url: string; label: string }[];
  }[];
}
const { covers } = Astro.props;
---

<div class="relative">
  <!-- Mobile: one cover at a time -->
  <div class="sm:hidden">
    <div id="covers-track-mobile" class="overflow-hidden relative">
      <div class="flex transition-transform duration-300" id="covers-slider">
        {covers.map(cover => (
          <div class="w-full flex-shrink-0 flex justify-center px-4">
            <div class="flex flex-col" style="width: 200px;">
              <a href={`/books/${cover.slug}`} class="group block relative shadow-md" style="width: 200px;" draggable="false">
                <Image
                  src={cover.src}
                  alt={cover.title}
                  widths={[200, 400]}
                  sizes="200px"
                  loading="lazy"
                  draggable="false"
                  style="width: 200px; height: auto; display: block;"
                />
                <div class="absolute inset-0 bg-white/0 group-hover:bg-white/10 transition-colors duration-300"></div>
              </a>
              <div class="pt-3">
                <a href={`/books/${cover.slug}`} class="font-heading font-semibold text-sm leading-tight hover:text-dp-gold-ink transition-colors">
                  {cover.title}
                </a>
                {cover.description && (
                  <p class="text-dp-muted text-xs leading-relaxed mt-1.5 cursor-default">{cover.description}</p>
                )}
                {cover.links && cover.links.length > 0 && (
                  <div class="mt-2">
                    <MarketplaceLinks links={cover.links} marketplace={cover.marketplace} />
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
      <!-- Tap zones -->
      <button id="covers-mobile-prev" aria-label="Назад" class="absolute left-0 top-0 bottom-0 w-1/4 z-10"></button>
      <button id="covers-mobile-next" aria-label="Вперёд" class="absolute right-0 top-0 bottom-0 w-1/4 z-10"></button>
    </div>
    {covers.length > 1 && (
      <div class="flex justify-center gap-2 mt-3">
        {covers.map((_, i) => (
          <button class="covers-dot w-2 h-2 rounded-full bg-dp-border transition-colors" data-index={i}></button>
        ))}
      </div>
    )}
  </div>

  <!-- Desktop: scrollable track with hover arrows -->
  <div class="hidden sm:block overflow-visible">
    <div
      id="covers-track"
      class="flex gap-6 overflow-x-auto overflow-y-clip select-none pt-10 pb-4 px-4"
      style="scrollbar-width: none; -ms-overflow-style: none; scroll-snap-type: x mandatory;"
    >
      {covers.map(cover => (
        <div class="flex-shrink-0 flex flex-col snap-center transition-transform duration-300 hover:scale-105 hover:-translate-y-2" style="width: 200px;">
          <a href={`/books/${cover.slug}`} class="block relative shadow-md" style="width: 200px;" draggable="false">
            <Image
              src={cover.src}
              alt={cover.title}
              widths={[200, 400]}
              sizes="200px"
              loading="lazy"
              draggable="false"
              style="width: 200px; height: auto; display: block;"
            />
          </a>
          <div class="pt-3">
            <a href={`/books/${cover.slug}`} class="font-heading font-semibold text-sm leading-tight hover:text-dp-gold-ink transition-colors">
              {cover.title}
            </a>
            {cover.description && (
              <p class="text-dp-muted text-xs leading-relaxed mt-1.5 cursor-default">{cover.description}</p>
            )}
            {cover.links && cover.links.length > 0 && (
              <div class="mt-2">
                <MarketplaceLinks links={cover.links} marketplace={cover.marketplace} />
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Left hover zone -->
    <GalleryArrow direction="left" id="covers-prev" />

    <!-- Right hover zone -->
    <GalleryArrow direction="right" id="covers-next" />
  </div>
</div>

<style>
  #covers-track::-webkit-scrollbar { display: none; }
  .covers-dot.active { background-color: #C9A84C; }
</style>

<script>
  import { initSlider } from '../lib/slider';
  initSlider({ prefix: 'covers', step: 240 });
</script>
