---
import SocialBar from './SocialBar.astro';
import type { SocialLink } from '../lib/types';

interface Props {
  copyright: string;
  socials: SocialLink[];
}
const { copyright, socials } = Astro.props;
---
<footer class="border-t border-dp-border mt-20">
  <div class="max-w-5xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
    <span class="font-heading text-dp-muted text-sm whitespace-nowrap">{copyright} &copy; {new Date().getFullYear()}</span>
    {socials.length > 0 && <SocialBar socials={socials} variant="footer" />}
    <nav class="flex gap-6" aria-label="Навигация в подвале">
      <a href="/" class="text-xs tracking-widest uppercase text-dp-muted hover:text-dp-text transition-colors">Главная</a>
      <a href="/books" class="text-xs tracking-widest uppercase text-dp-muted hover:text-dp-text transition-colors">Книги</a>
      <a href="/about" class="text-xs tracking-widest uppercase text-dp-muted hover:text-dp-text transition-colors">Об авторах</a>
    </nav>
  </div>
</footer>
