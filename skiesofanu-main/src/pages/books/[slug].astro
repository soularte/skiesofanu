---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookHero from '../../components/book/BookHero.astro';
import SeriesAbout from '../../components/book/SeriesAbout.astro';
import Booktrailer from '../../components/book/Booktrailer.astro';
import Reviews from '../../components/book/Reviews.astro';
import BooksInSeries from '../../components/book/BooksInSeries.astro';
import CharactersSection from '../../components/book/CharactersSection.astro';
import WorldSection from '../../components/book/WorldSection.astro';
import LoreSection from '../../components/book/LoreSection.astro';
import CardsGallery from '../../components/CardsGallery.astro';
import GoldLine from '../../components/GoldLine.astro';
import { getCollection, render } from 'astro:content';
import { loadDataFile } from '../../lib/data';
import { findImage } from '../../lib/images';
import type { AuthorsData } from '../../lib/types';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map(book => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const data = book.data;
const isSeries = !!(data.books && data.books.length > 0);
const hasSeriesAbout = !!(data.series && (data.seriesDescription || (data.readingOrder && data.readingOrder.length > 0)));
const coverImg = findImage(data.cover);

const authorsData = loadDataFile<AuthorsData>('src/data/authors.md', {
  bio: [],
  ksenia: { name: 'Ксения Котова', photo: 'kk.jpg' },
  vasily: { name: 'Василий Зеленков', photo: 'vz.jpg' },
});

const canonicalURL = new URL(`/books/${book.slug}/`, Astro.site ?? Astro.url.origin).href;

const allLore = await getCollection('lore');
const bookLore = allLore
  .filter(l => l.data.book === book.slug)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'));

let cardImages: string[] = [];
if (data.cardsFolder) {
  const cardsDir = path.join(process.cwd(), 'public', 'cards', data.cardsFolder);
  if (fs.existsSync(cardsDir)) {
    cardImages = fs.readdirSync(cardsDir)
      .filter(f => /\.(jpe?g|png|webp|avif)$/i.test(f))
      .sort((a, b) => a.localeCompare(b, 'ru'))
      .map(f => `/cards/${data.cardsFolder}/${f}`);
  }
}

const coverURL = coverImg
  ? new URL(coverImg.src, Astro.site ?? Astro.url.origin).href
  : new URL('/favicon.ico', Astro.site ?? Astro.url.origin).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: data.title,
  description: data.logline ?? data.shortDescription ?? '',
  genre: data.genres ?? [],
  image: coverURL,
  url: canonicalURL,
  inLanguage: 'ru',
  author: [
    { '@type': 'Person', name: authorsData.ksenia.name },
    { '@type': 'Person', name: authorsData.vasily.name },
  ],
  ...(data.series ? { isPartOf: { '@type': 'BookSeries', name: data.series } } : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Книги',
      item: new URL('/books/', Astro.site ?? Astro.url.origin).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: data.title,
      item: canonicalURL,
    },
  ],
};
---
<style is:global>
  summary { display: block; }
  summary::-webkit-details-marker { display: none; }
  .section-chevron {
    transition: transform 0.2s ease;
    color: #C9A84C;
  }
  details[open] .section-chevron {
    transform: rotate(90deg);
  }
</style>
<BaseLayout
  title={data.title}
  description={data.logline ?? data.shortDescription ?? data.title}
  image={coverURL}
  canonicalURL={canonicalURL}
  ogType="book"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <div class="max-w-5xl mx-auto px-6 pt-10 pb-16">

    <!-- Breadcrumb -->
    <nav class="mb-6 text-xs tracking-widest uppercase text-dp-muted">
      <a href="/books" class="hover:text-dp-gold transition-colors">Книги</a>
      <span class="mx-2">→</span>
      <span class="text-dp-text">{data.series ?? data.title}</span>
    </nav>

    <!-- Series title above grid -->
    {data.series && (
      <div class="text-center mb-16">
        <h1 class="font-heading text-4xl md:text-5xl font-semibold text-dp-gold-ink">{data.series}</h1>
        <GoldLine class="mx-auto mt-4" />
        {data.seriesSubtitle && (
          <p class="font-accent italic text-dp-muted text-base mt-2 leading-relaxed">{data.seriesSubtitle}</p>
        )}
      </div>
    )}

    <BookHero data={data} Content={Content} />

    {cardImages.length > 0 && (
      <div class="mt-10 mb-10">
        <CardsGallery images={cardImages} />
      </div>
    )}

    {hasSeriesAbout && <SeriesAbout data={data} />}

    {data.booktrailer && data.booktrailer.visible !== false && (
      <Booktrailer trailer={data.booktrailer} />
    )}

    {data.reviews && data.reviews.length > 0 && (
      <Reviews reviews={data.reviews} />
    )}

    {isSeries && (
      <BooksInSeries books={data.books ?? []} />
    )}

    {data.characters && data.characters.length > 0 && (
      <CharactersSection characters={data.characters} folder={data.charactersFolder} maps={data.characterMaps} />
    )}

    {data.world && (
      <WorldSection world={data.world} maps={data.worldMaps} />
    )}

    {bookLore.length > 0 && (
      <LoreSection items={bookLore} bookSlug={book.slug} />
    )}

  </div>
</BaseLayout>
