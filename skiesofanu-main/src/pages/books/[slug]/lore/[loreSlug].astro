---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TagChip from '../../../../components/TagChip.astro';
import GoldLine from '../../../../components/GoldLine.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const loreEntries = await getCollection('lore');
  const books = await getCollection('books');

  // Group by book and sort alphabetically within each group
  const byBook: Record<string, typeof loreEntries> = {};
  for (const entry of loreEntries) {
    (byBook[entry.data.book] ??= []).push(entry);
  }
  for (const slug of Object.keys(byBook)) {
    byBook[slug].sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'));
  }

  return loreEntries.map(entry => {
    const book = books.find(b => b.slug === entry.data.book);
    const siblings = byBook[entry.data.book];
    return {
      params: { slug: entry.data.book, loreSlug: entry.slug },
      props: {
        entry,
        bookTitle: book?.data.series ?? book?.data.title ?? entry.data.book,
        allItems: siblings.map(s => ({ slug: s.slug, title: s.data.title, tags: s.data.tags ?? [] })),
      },
    };
  });
}

const { entry, bookTitle, allItems } = Astro.props;
const { Content } = await entry.render();
const bookSlug = entry.data.book;

const siteOrigin = (Astro.site ?? new URL(Astro.url.origin)).href;
const canonicalURL = new URL(`/books/${bookSlug}/lore/${entry.slug}/`, siteOrigin).href;
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.excerpt}
  image={entry.data.cover}
  canonicalURL={canonicalURL}
  ogType="article"
>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <header class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
        <nav class="text-xs tracking-widest uppercase text-dp-muted">
          <a href="/books" class="hover:text-dp-gold transition-colors">Книги</a>
          <span class="mx-2">→</span>
          <a href={`/books/${bookSlug}`} class="hover:text-dp-gold transition-colors">{bookTitle}</a>
          <span class="mx-2">→</span>
          <span class="text-dp-text">Материалы</span>
        </nav>
        <div class="flex gap-4 mt-2 sm:mt-0 self-end sm:self-auto lore-nav-top"></div>
      </div>
      <h1 class="font-heading text-3xl font-semibold mt-2 mb-4">{entry.data.title}</h1>
      {entry.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {entry.data.tags.map(tag => <TagChip tag={tag} />)}
        </div>
        </div>
      )}
      {entry.data.cover && (
        <div class="aspect-[4/3] overflow-hidden border border-dp-border mb-4">
          <img
            src={entry.data.cover}
            alt={entry.data.title}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      )}
      <GoldLine />
    </header>

    <div class="prose-content max-w-none text-dp-text leading-relaxed">
      <Content />
    </div>

    <footer class="mt-12 pt-6 border-t border-dp-border">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-2">
        <a href={`/books/${bookSlug}`} class="text-xs tracking-widest uppercase text-dp-gold-ink hover:text-dp-text transition-colors">
          ← Назад
        </a>
        <div class="flex gap-4 self-end sm:self-auto lore-nav-bottom"></div>
      </div>
    </footer>
  </article>

  <script type="application/json" id="lore-items-data" set:html={JSON.stringify({ items: allItems, currentSlug: entry.slug, bookSlug })} />

  <script>
    // Make all images in lore content clickable for lightbox
    document.querySelectorAll('.prose-content img').forEach((img) => {
      img.setAttribute('data-lightbox-group', 'lore-article');
      img.setAttribute('data-lightbox-src', (img as HTMLImageElement).src);
    });

    // Dynamic prev/next based on ?tag= parameter
    (function() {
      const dataEl = document.getElementById('lore-items-data');
      if (!dataEl) return;
      const { items, currentSlug, bookSlug } = JSON.parse(dataEl.textContent || '{}');
      const tag = new URLSearchParams(window.location.search).get('tag');

      const filtered = tag && tag !== 'all'
        ? items.filter((i: any) => i.tags.includes(tag))
        : items;

      const idx = filtered.findIndex((i: any) => i.slug === currentSlug);
      const prev = idx > 0 ? filtered[idx - 1] : null;
      const next = idx < filtered.length - 1 ? filtered[idx + 1] : null;

      const tagParam = tag && tag !== 'all' ? `?tag=${encodeURIComponent(tag)}` : '';
      const linkClass = 'text-xs tracking-widest uppercase text-dp-muted hover:text-dp-gold-ink transition-colors';

      function renderNav(container: Element) {
        let html = '';
        if (prev) {
          html += `<a href="/books/${bookSlug}/lore/${prev.slug}${tagParam}" class="${linkClass}" title="${prev.title}">← Предыдущая</a>`;
        }
        if (next) {
          html += `<a href="/books/${bookSlug}/lore/${next.slug}${tagParam}" class="${linkClass}" title="${next.title}">Следующая →</a>`;
        }
        container.innerHTML = html;
      }

      document.querySelectorAll('.lore-nav-top, .lore-nav-bottom').forEach(renderNav);
    })();
  </script>
</BaseLayout>
