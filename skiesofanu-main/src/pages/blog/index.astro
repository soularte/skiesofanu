---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagChip from '../../components/TagChip.astro';
import TagFilter from '../../components/TagFilter.astro';
import GoldLine from '../../components/GoldLine.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { loadDataFile } from '../../lib/data';
import { findImage } from '../../lib/images';
import type { SiteData } from '../../lib/types';

const site = loadDataFile<SiteData>('src/data/site.md', {
  siteName: '',
  defaultDescription: '',
  privacyText: '',
});

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Collect all unique tags
const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---

<BaseLayout title="Блог" description="Блог авторского дуэта: заметки, размышления и закулисье творчества.">
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-4">
    <div class="text-center mb-16">
      <h1 class="font-heading text-4xl md:text-5xl font-semibold">Блог</h1>
      <GoldLine class="mx-auto mt-4" />
      {site.blogSubtitle && (
        <p class="font-accent italic text-dp-muted text-base mt-2 leading-relaxed">
          {site.blogSubtitle}
        </p>
      )}
    </div>

    <!-- Tag cloud -->
    <TagFilter tags={allTags} group="blog" class="justify-center mb-10" />

    <!-- Posts -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
      {posts.map(post => {
        const coverSrc = post.data.cover ? findImage(post.data.cover) : undefined;

        return (
          <article
            class="blog-card border border-dp-border flex flex-col hover:border-dp-gold/50 transition-colors overflow-hidden"
            data-tags={post.data.tags.join(',')}
          >
            <a href={`/blog/${post.slug}`} class="block aspect-[4/3] overflow-hidden">
              {coverSrc ? (
                <Image
                  src={coverSrc}
                  alt={post.data.title}
                  width={800}
                  height={600}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full bg-dp-dark/5 flex items-center justify-center">
                  <span class="text-dp-muted/40 text-4xl font-heading">
                    {post.data.title.charAt(0)}
                  </span>
                </div>
              )}
            </a>

            <div class="p-6 flex flex-col gap-3 flex-1">
              <time class="text-xs tracking-widest uppercase text-dp-muted">
                {post.data.date.toLocaleDateString('ru-RU', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </time>

              <h2 class="font-heading text-lg font-semibold leading-tight">
                <a href={`/blog/${post.slug}`} class="hover:text-dp-gold transition-colors">
                  {post.data.title}
                </a>
              </h2>

              <p class="text-sm text-dp-muted leading-relaxed flex-1">
                {post.data.excerpt}
              </p>

              <div class="flex flex-wrap gap-1 mt-2">
                {post.data.tags.map(tag => <TagChip tag={tag} />)}
              </div>

              <a
                href={`/blog/${post.slug}`}
                class="text-xs tracking-widest uppercase text-dp-gold-ink hover:text-dp-text transition-colors mt-2"
              >
                Читать →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filter = document.querySelector('[data-filter-group="blog"]');
      if (!filter) return;

      filter.addEventListener('filter-change', (e) => {
        const activeTag = e.detail.tag;
        const cards = document.querySelectorAll('.blog-card');

        cards.forEach(card => {
          const links = card.querySelectorAll('a[href^="/blog/"]');

          links.forEach(link => {
            const baseHref = link.getAttribute('href').split('?')[0];
            link.setAttribute(
              'href',
              activeTag !== 'all'
                ? baseHref + '?tag=' + encodeURIComponent(activeTag)
                : baseHref
            );
          });

          if (activeTag === 'all') {
            card.classList.remove('hidden');
          } else {
            const cardTags = card.getAttribute('data-tags').split(',');
            card.classList.toggle('hidden', !cardTags.includes(activeTag));
          }
        });
      });
    });
  </script>
</BaseLayout>