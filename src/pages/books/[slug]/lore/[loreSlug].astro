---
import { schemaAuthors } from '../../../../lib/schema';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageNav from '../../../../components/PageNav.astro';
import TagChip from '../../../../components/TagChip.astro';
import GoldLine from '../../../../components/GoldLine.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const loreEntries = (await getCollection('lore')).filter(l => !l.data.draft);
  const books = await getCollection('books');

  // Group by book and sort alphabetically within each group
  const byBook: Record<string, typeof loreEntries> = {};
  for (const entry of loreEntries) {
    (byBook[entry.data.book] ??= []).push(entry);
  }
  for (const slug of Object.keys(byBook)) {
    byBook[slug].sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'));
  }

  return loreEntries.map(entry => {
    const book = books.find(b => b.slug === entry.data.book);
    const siblings = byBook[entry.data.book];
    const idx = siblings.findIndex(s => s.slug === entry.slug);
    const prev = idx > 0 ? siblings[idx - 1] : null;
    const next = idx < siblings.length - 1 ? siblings[idx + 1] : null;
    return {
      params: { slug: entry.data.book, loreSlug: entry.slug },
      props: {
        entry,
        bookTitle: book?.data.series ?? book?.data.title ?? entry.data.book,
        allItems: siblings.map(s => ({ slug: s.slug, title: s.data.title, tags: s.data.tags ?? [] })),
        prev,
        next,
      },
    };
  });
}

const { entry, bookTitle, allItems, prev, next } = Astro.props;
const { Content } = await entry.render();
const bookSlug = entry.data.book;

const siteOrigin = (Astro.site ?? new URL(Astro.url.origin)).href;
const canonicalURL = new URL(`/books/${bookSlug}/lore/${entry.slug}/`, siteOrigin).href;
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article', '@id': `${canonicalURL}#article`,
  headline: entry.data.title, description: entry.data.excerpt,
  url: canonicalURL, mainEntityOfPage: canonicalURL, inLanguage: 'ru',
  datePublished: entry.data.date.toISOString(), author: schemaAuthors(siteOrigin),
  ...(entry.data.cover ? {image: new URL(entry.data.cover, siteOrigin).href} : {}),
};
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.excerpt}
  image={entry.data.cover}
  canonicalURL={canonicalURL}
  additionalSchema={articleLd}
  ogType="article"
>
  <article class="max-w-3xl mx-auto px-6 pt-4 pb-12">
    <header class="mb-8">
      <PageNav
        section="Материалы"
        sectionHref={`/books/${bookSlug}`}
        title={entry.data.title}
        prev={prev ? { href: `/books/${bookSlug}/lore/${prev.slug}`, title: prev.data.title } : null}
        next={next ? { href: `/books/${bookSlug}/lore/${next.slug}`, title: next.data.title } : null}
        position="top"
      />

      <h1 class="font-heading text-3xl font-semibold mt-2 mb-4">{entry.data.title}</h1>
      {entry.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-4">
          {entry.data.tags.map(tag => <TagChip tag={tag} />)}
        </div>
      )}
      {entry.data.cover && (
        <div class="aspect-[4/3] overflow-hidden border border-dp-border mb-4">
          <img
            src={entry.data.previewCover ?? entry.data.cover}
            data-lightbox-group={entry.slug === 'aviatory-map' ? 'lore-cover' : undefined}
            data-lightbox-src={entry.slug === 'aviatory-map' ? '/images/lore/aviatory-map.png' : undefined}
            alt={entry.data.title}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      )}
      <GoldLine />
    </header>

    <div class="prose-content max-w-none text-dp-text leading-relaxed">
      <Content />
    </div>

    <footer class="mt-12 pt-4 border-t border-dp-border">
      <PageNav
        section="Материалы"
        sectionHref={`/books/${bookSlug}`}
        title={entry.data.title}
        prev={prev ? { href: `/books/${bookSlug}/lore/${prev.slug}`, title: prev.data.title } : null}
        next={next ? { href: `/books/${bookSlug}/lore/${next.slug}`, title: next.data.title } : null}
        position="bottom"
      />
    </footer>
  </article>

  <script type="application/json" id="lore-items-data" set:html={JSON.stringify({ items: allItems, currentSlug: entry.slug, bookSlug })} />

  <script>
    // Make all images in lore content clickable for lightbox
    document.querySelectorAll('.prose-content img').forEach((img) => {
      img.setAttribute('data-lightbox-group', 'lore-article');
      if (!img.hasAttribute('data-lightbox-src')) {
        img.setAttribute('data-lightbox-src', (img as HTMLImageElement).src);
      }
    });

    // Patch nav hrefs when ?tag= is present
    (function() {
      const dataEl = document.getElementById('lore-items-data');
      if (!dataEl) return;
      const { items, currentSlug, bookSlug } = JSON.parse(dataEl.textContent || '{}');
      const tag = new URLSearchParams(window.location.search).get('tag');
      if (!tag || tag === 'all') return;

      const filtered = items.filter((i: any) => i.tags.includes(tag));
      const idx = filtered.findIndex((i: any) => i.slug === currentSlug);
      if (idx === -1) return;

      const tagParam = `?tag=${encodeURIComponent(tag)}`;
      const prevItem = idx > 0 ? filtered[idx - 1] : null;
      const nextItem = idx < filtered.length - 1 ? filtered[idx + 1] : null;

      document.querySelectorAll('[data-nav-prev]').forEach((el) => {
        const a = el as HTMLAnchorElement;
        if (prevItem) {
          a.href = `/books/${bookSlug}/lore/${prevItem.slug}${tagParam}`;
          const label = a.querySelector('.hidden');
          if (label) label.textContent = prevItem.title;
        } else {
          a.closest('.nav-link-wrap')?.classList.add('invisible');
        }
      });

      document.querySelectorAll('[data-nav-next]').forEach((el) => {
        const a = el as HTMLAnchorElement;
        if (nextItem) {
          a.href = `/books/${bookSlug}/lore/${nextItem.slug}${tagParam}`;
          const label = a.querySelector('.hidden');
          if (label) label.textContent = nextItem.title;
        } else {
          a.closest('.nav-link-wrap')?.classList.add('invisible');
        }
      });
    })();
  </script>
</BaseLayout>
