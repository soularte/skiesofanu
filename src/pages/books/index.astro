---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarketplaceLinks from '../../components/MarketplaceLinks.astro';
import GenreChip from '../../components/GenreChip.astro';
import GoldLine from '../../components/GoldLine.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { findImage } from '../../lib/images';
import { loadDataFile } from '../../lib/data';
import type { SiteData } from '../../lib/types';

const site = loadDataFile<SiteData>('src/data/site.md', { siteName: '', defaultDescription: '', privacyText: '' });
const ui = loadDataFile<any>('src/data/ui.md', { home: {} });
const booksHeading = ui.home?.booksHeading ?? 'Книги';

const allBooks = await getCollection('books');

// Только книги или серии для вывода в список
const visibleBooks = allBooks.filter(b =>
  !b.data.series || (b.data.books && b.data.books.length > 0)
);

// Сортировка по displayOrder из frontmatter
const sorted = [...visibleBooks].sort((a, b) =>
  (a.data.displayOrder ?? 999) - (b.data.displayOrder ?? 999)
);

// Предварительно рендер тела книги (если нет mediumDescription)
const ordered = await Promise.all(
  sorted.map(async book => {
    if (book.data.mediumDescription) return { book, Content: null };
    const { Content } = await render(book);
    return { book, Content };
  })
);
---
<BaseLayout title={booksHeading} description={site.seoBooks ?? ''}>
  <div class="max-w-5xl mx-auto px-6 pt-8 pb-16">
    <div class="text-center mb-6 md:mb-16">
      <h1 class="font-heading text-4xl md:text-5xl font-semibold">{booksHeading}</h1>
      <GoldLine class="mx-auto mt-4" />
      {site.booksSubtitle && <p class="font-accent italic text-dp-muted text-base mt-2 leading-relaxed">{site.booksSubtitle}</p>}
    </div>

    <div class="space-y-10 md:space-y-16 divide-y divide-dp-border/50 md:divide-y-0 [&>*]:pt-10 md:[&>*]:pt-0 [&>*:first-child]:pt-0">
      {ordered.map(({ book, Content }, i) => {
        const coverImg = findImage(book.data.cover);
        return (
        <article class={`flex flex-col items-center md:items-start md:flex-row gap-10 ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
          <!-- Cover -->
          <a href={`/books/${book.slug}`} class="flex-shrink-0 relative group">
            {coverImg && (
              <Image
                src={coverImg}
                alt={book.data.title}
                widths={[224, 448]}
                sizes="224px"
                class="w-56 h-auto shadow-md group-hover:shadow-lg transition-shadow duration-300 relative z-10"
              />
            )}
            <div class="absolute -bottom-2 -right-2 w-full h-full border border-dp-gold/30 pointer-events-none z-0"></div>
            <div class="absolute inset-0 bg-white/0 group-hover:bg-white/10 transition-colors duration-300 z-10"></div>
          </a>
          <!-- Info -->
          <div class="flex-1">
            <h2 class="font-heading text-2xl md:text-3xl font-semibold mb-2">
              <a href={`/books/${book.slug}`} class="hover:text-dp-gold transition-colors">{book.data.title}</a>
            </h2>
            <!-- Genres -->
            <div class="flex flex-wrap gap-1 mb-3">
              {book.data.genres.map(g => <GenreChip label={g} />)}
            </div>
            <GoldLine size="sm" class="mb-4" />
            <div class="mb-6 space-y-3">
              {book.data.mediumDescription
                ? book.data.mediumDescription.split('\n\n').filter((p: string) => p.trim()).map((para: string) => (
                    <p class="text-dp-muted leading-relaxed">{para.trim()}</p>
                  ))
                : Content && <div class="prose prose-sm max-w-none text-dp-muted leading-relaxed [&>p]:mb-3"><Content /></div>
              }
            </div>
            {(book.data.links ?? []).length > 0 && (
              <div class="mb-6">
                <MarketplaceLinks links={book.data.links ?? []} marketplace={book.data.marketplace} />
              </div>
            )}
            <a href={`/books/${book.slug}`} class="px-5 py-2 bg-dp-gold text-dp-dark text-sm tracking-widest uppercase hover:bg-dp-copper transition-colors inline-block">
              Подробнее
            </a>
          </div>
        </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
