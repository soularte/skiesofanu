---
import { schemaAuthors } from '../../lib/schema';
import seoPages from '../../data/seo.json';
import PageSectionMenu from '../../components/book/PageSectionMenu.astro';
import BookDescription from '../../components/book/BookDescription.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarketplaceLinks from '../../components/MarketplaceLinks.astro';
import GenreChip from '../../components/GenreChip.astro';
import GoldLine from '../../components/GoldLine.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { findImage } from '../../lib/images';
import { loadDataFile } from '../../lib/data';
import type { SiteData } from '../../lib/types';

const site = loadDataFile<SiteData>('src/data/site.md', { siteName: '', defaultDescription: '', privacyText: '' });
const ui = loadDataFile<any>('src/data/ui.md', { home: {} });
const booksHeading = ui.home?.booksHeading ?? 'Книги';

function catalogTitle(data: { title: string; series?: string }) {
  return data.series ? `Цикл «${data.series}»` : data.title;
}
function bookCount(count: number) {
  const form = new Intl.PluralRules('ru').select(count);
  return `${count} ${form === 'one' ? 'книга' : form === 'few' ? 'книги' : 'книг'}`;
}

const allBooks = await getCollection('books');

// Только книги или серии для вывода в список
const visibleBooks = allBooks.filter(b =>
  !b.data.series || (b.data.books && b.data.books.length > 0)
);

// Сортировка по displayOrder из frontmatter
const sorted = [...visibleBooks].sort((a, b) =>
  (a.data.displayOrder ?? 999) - (b.data.displayOrder ?? 999)
);

// Предварительно рендер тела книги (если нет mediumDescription)
const ordered = await Promise.all(
  sorted.map(async book => {
    if (book.data.mediumDescription) return { book, Content: null };
    const { Content } = await render(book);
    return { book, Content };
  })
);
const catalogURL = new URL('/books/', Astro.site ?? Astro.url.origin).href;
const catalogSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  '@id': catalogURL + '#collection', url: catalogURL,
  name: seoPages['/books/'].title, description: seoPages['/books/'].description,
  inLanguage: 'ru', isPartOf: { '@id': new URL('/#website', catalogURL).href },
  mainEntity: {
    '@type': 'ItemList', '@id': catalogURL + '#books',
    numberOfItems: sorted.length, itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: sorted.map((book, index) => {
      const url = new URL('/books/' + book.slug + '/', catalogURL).href;
      const image = findImage(book.data.cover);
      return {
        '@type': 'ListItem', position: index + 1,
        item: {
          '@type': book.data.series ? 'BookSeries' : 'Book',
          '@id': url + (book.data.series ? '#series' : '#book'),
          url, name: book.data.series ?? book.data.title,
          description: book.data.seoDescription ?? book.data.shortDescription,
          inLanguage: 'ru', author: schemaAuthors(catalogURL, book.data.authors),
          ...(image ? { image: new URL(image.src, catalogURL).href } : {}),
        },
      };
    }),
  },
};
---
<BaseLayout title={booksHeading} description={site.seoBooks ?? ''} canonicalURL={catalogURL} additionalSchema={catalogSchema}>
  <div class="max-w-5xl mx-auto px-6 pt-8 pb-16">
    <div class="text-center mb-6">
      <h1 class="font-heading text-4xl md:text-5xl font-semibold">{booksHeading}</h1>
      <GoldLine class="mx-auto mt-4" />
      {site.booksSubtitle && <p class="font-accent italic text-dp-muted text-base mt-2 leading-relaxed">{site.booksSubtitle}</p>}
    </div>

    <PageSectionMenu catalogShelf items={sorted.map(book => ({ id: `catalog-${book.slug}`, label: catalogTitle(book.data), detail: book.data.series ? bookCount(book.data.books?.length ?? 0) : undefined, image: findImage(`navigation/${book.slug}.webp`) ?? findImage(book.data.cover) }))} />

    <div class="space-y-10 md:space-y-16 divide-y divide-dp-border/50 md:divide-y-0 [&>*]:pt-10 md:[&>*]:pt-0 [&>*:first-child]:pt-0">
      {ordered.map(({ book, Content }, i) => {
        const coverImg = findImage(book.data.cover);
        return (
        <article id={`catalog-${book.slug}`} data-atlas-section class={`flex flex-col items-center md:items-start md:flex-row gap-10 ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
          <!-- Cover -->
          <a href={`/books/${book.slug}`} class="flex-shrink-0 relative group">
            {coverImg && (
              <Image
                src={coverImg}
                alt={book.data.title}
                widths={[224, 448]}
                sizes="224px"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                class="w-56 h-auto shadow-md group-hover:shadow-lg transition-shadow duration-300 relative z-10"
              />
            )}
            <div class="absolute -bottom-2 -right-2 w-full h-full border border-dp-gold/30 pointer-events-none z-0"></div>
            <div class="absolute inset-0 bg-white/0 group-hover:bg-white/10 transition-colors duration-300 z-10"></div>
          </a>
          <!-- Info -->
          <div class="flex-1">
            <h2 class="font-heading text-2xl md:text-3xl font-semibold mb-2">
              <a href={`/books/${book.slug}`} class="hover:text-dp-gold transition-colors">{catalogTitle(book.data)}</a>
            </h2>
            <!-- Genres -->
            <div class="flex flex-wrap items-center gap-1 mb-3">
              {book.data.genres.map(g => <GenreChip label={g} />)}
              {book.data.series && <span class="text-sm text-dp-muted ml-2">{bookCount(book.data.books?.length ?? 0)}</span>}
            </div>
            <GoldLine size="sm" class="mb-4" />
            <div class="mb-6 space-y-3">
              <BookDescription
                description={book.data.mediumDescription}
                Content={Content}
                paragraphClass="text-dp-muted leading-relaxed"
                fallbackClass="prose prose-sm max-w-none text-dp-muted leading-relaxed [&>p]:mb-3"
              />
            </div>
            {(book.data.links ?? []).length > 0 && (
              <div class="mb-6">
                <MarketplaceLinks links={book.data.links ?? []} marketplace={book.data.marketplace} />
              </div>
            )}
            <a href={`/books/${book.slug}`} class="catalog-details px-5 py-2 bg-dp-gold text-dp-dark text-sm tracking-widest uppercase hover:bg-dp-copper transition-colors inline-block">
              Подробнее
            </a>
          </div>
        </article>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  @media (max-width: 767px) {
    .catalog-details { display: table; margin-inline: auto; }
  }
</style>
