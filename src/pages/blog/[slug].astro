---
import { schemaAuthors } from '../../lib/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageNav from '../../components/PageNav.astro';
import TagChip from '../../components/TagChip.astro';
import GoldLine from '../../components/GoldLine.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { loadDataFile } from '../../lib/data';
import { findImage } from '../../lib/images';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(p => !p.data.draft).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const allItems = posts.map(p => ({ slug: p.slug, title: p.data.title, tags: p.data.tags ?? [] }));

  return posts.map((post, idx) => {
    const next = idx > 0 ? posts[idx - 1] : null;
    const prev = idx < posts.length - 1 ? posts[idx + 1] : null;
    return {
      params: { slug: post.slug },
      props: { post, allItems, prev, next },
    };
  });
}

const { post, allItems, prev, next } = Astro.props;
const { Content } = await post.render();

const coverSrc = post.data.cover ? findImage(post.data.cover) : undefined;
const coverUrl = coverSrc
  ? new URL(coverSrc.src, Astro.site ?? Astro.url.origin).href
  : undefined;

const ui = loadDataFile<any>('src/data/ui.md', { blog: {}, pageNav: {} });
const blogUi = ui.blog ?? {};
const pageNav = ui.pageNav ?? {};

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  url: canonicalURL,
  inLanguage: 'ru',
  author: schemaAuthors(canonicalURL),
  '@id': `${canonicalURL}#article`,
  mainEntityOfPage: canonicalURL,
  ...(coverUrl ? { image: coverUrl } : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: blogUi.heading, item: new URL('/blog/', Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 2, name: post.data.title, item: canonicalURL },
  ],
};
---

<BaseLayout title={post.data.title} description={post.data.excerpt} image={coverUrl} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <article class="max-w-3xl mx-auto px-6 pt-4 pb-12">
    <header class="mb-8">
      <PageNav
        section={blogUi.heading}
        sectionHref="/blog"
        title={post.data.title}
        prev={next ? { href: `/blog/${next.slug}`, title: pageNav.newer } : null}
        next={prev ? { href: `/blog/${prev.slug}`, title: pageNav.older } : null}
        position="top"
      />

      <time class="mt-6 block text-xs tracking-widest uppercase text-dp-muted">
        {post.data.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
      </time>

      <h1 class="font-heading text-3xl font-semibold mt-2 mb-4">{post.data.title}</h1>

      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags.map(tag => <TagChip tag={tag} />)}
      </div>

      {coverSrc && (
        <div class="aspect-[4/3] overflow-hidden border border-dp-border mb-4">
          <Image
            src={coverSrc}
            alt={post.data.title}
            width={800}
            height={600}
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <GoldLine />
    </header>

    <div class="prose-content max-w-none text-dp-text leading-relaxed">
      <Content />
    </div>

    <footer class="mt-12 pt-4 border-t border-dp-border">
      <PageNav
        section={blogUi.heading}
        sectionHref="/blog"
        title={post.data.title}
        prev={next ? { href: `/blog/${next.slug}`, title: pageNav.newer } : null}
        next={prev ? { href: `/blog/${prev.slug}`, title: pageNav.older } : null}
        position="bottom"
      />
    </footer>
  </article>

  <script type="application/json" id="blog-items-data" set:html={JSON.stringify({ items: allItems, currentSlug: post.slug })} />

  <script>
    document.querySelectorAll('.prose-content img').forEach((img) => {
      img.setAttribute('data-lightbox-group', 'blog-article');
      img.setAttribute('data-lightbox-src', (img as HTMLImageElement).src);
    });

    // Dynamic prev/next based on ?tag= parameter — patches hrefs only
    (function() {
      const dataEl = document.getElementById('blog-items-data');
      if (!dataEl) return;

      const { items, currentSlug } = JSON.parse(dataEl.textContent || '{}');
      const tag = new URLSearchParams(window.location.search).get('tag');
      if (!tag || tag === 'all') return;

      const filtered = items.filter((i: any) => i.tags.includes(tag));
      const idx = filtered.findIndex((i: any) => i.slug === currentSlug);
      if (idx === -1) return;

      const newer = idx > 0 ? filtered[idx - 1] : null;
      const older = idx < filtered.length - 1 ? filtered[idx + 1] : null;
      const tagParam = `?tag=${encodeURIComponent(tag)}`;

      // Update all prev links (left arrows = newer/позднее)
      document.querySelectorAll('[data-nav-prev]').forEach((el) => {
        const a = el as HTMLAnchorElement;
        if (newer) {
          a.href = `/blog/${newer.slug}${tagParam}`;
        } else {
          a.closest('.nav-link-wrap')?.classList.add('invisible');
        }
      });

      // Update all next links (right arrows = older/ранее)
      document.querySelectorAll('[data-nav-next]').forEach((el) => {
        const a = el as HTMLAnchorElement;
        if (older) {
          a.href = `/blog/${older.slug}${tagParam}`;
        } else {
          a.closest('.nav-link-wrap')?.classList.add('invisible');
        }
      });
    })();
  </script>
</BaseLayout>