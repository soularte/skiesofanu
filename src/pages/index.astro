---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoversGallery from '../components/CoversGallery.astro';
import Divider from '../components/Divider.astro';
import GoldLine from '../components/GoldLine.astro';
import DecoratedBox from '../components/DecoratedBox.astro';
import LitPortals from '../components/LitPortals.astro';
import StartHere from '../components/StartHere.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { loadDataFile, loadDataFileWithContent, miniMarkdown } from '../lib/data';
import { findImage } from '../lib/images';
import type { NewsData, LinksData } from '../lib/types';
import kkPhoto from '../assets/images/authors/kk.jpg';
import vzPhoto from '../assets/images/authors/vz.jpg';

const { data: news, content: newsContent } = loadDataFileWithContent<NewsData>('src/data/news.md', { visible: false });
const newsHtml = miniMarkdown(newsContent);

// Книги из коллекции (только видимые в галерее)
const allBooks = await getCollection('books');
const visibleBooks = allBooks.filter(b => !b.data.series || (b.data.books && b.data.books.length > 0));
const orderedBooks = [...visibleBooks].sort((a, b) =>
  (a.data.displayOrder ?? 999) - (b.data.displayOrder ?? 999)
);
const covers = orderedBooks
  .map(b => {
    const src = findImage(b.data.cover);
    if (!src) return null;
    return {
      slug: b.slug,
      title: b.data.title,
      src,
      description: b.data.shortDescription,
      marketplace: b.data.marketplace,
      links: b.data.links ?? [],
    };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);

const links = loadDataFile<LinksData>('src/data/links.md', {
  socials: [],
  litportals: { ksenia: [], vasily: [] },
  contact: { vk: '#', telegram: '#' },
});

const ui = loadDataFile<any>('src/data/ui.md', { home: {} });
const home = ui.home ?? {};

const authorsData = loadDataFile<any>('src/data/authors.md', {
  ksenia: { name: 'Ксения Котова' },
  vasily: { name: 'Василий Зеленков' },
});

// Blog posts (latest 3)
const blogPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Progress from news data
const visibleProgress = (news.progress?.visible && news.progress?.items)
  ? news.progress.items.filter(i => i.visible)
  : [];

// Progress ring colors (соответствуют токенам Tailwind: dp-border / акцентный красный)
const PROGRESS_TRACK = '#D4C5A9';
const PROGRESS_FILL = '#8B1A2B';
---
<BaseLayout title={home.booksHeading}>
  <!-- Hero -->
  <section class="relative overflow-hidden py-8 md:py-12">
    <div class="absolute inset-0 bg-gradient-to-b from-dp-dark via-dp-dark/95 to-dp-dark/80"></div>
    <div class="absolute top-5 left-6 w-10 h-10 border-l-2 border-t-2 border-dp-gold/40 z-10"></div>
    <div class="absolute top-5 right-6 w-10 h-10 border-r-2 border-t-2 border-dp-gold/40 z-10"></div>
    <div class="absolute bottom-5 left-6 w-10 h-10 border-l-2 border-b-2 border-dp-gold/40 z-10"></div>
    <div class="absolute bottom-5 right-6 w-10 h-10 border-r-2 border-b-2 border-dp-gold/40 z-10"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-1 xl:grid-cols-[200px_1fr_200px] items-center gap-0">
        <div class="hidden xl:block h-72 pointer-events-none overflow-hidden self-center"
          style="mask-image: linear-gradient(to right, transparent 0%, black 25%, black 60%, transparent 100%), linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); mask-composite: intersect; -webkit-mask-image: linear-gradient(to right, transparent 0%, black 25%, black 60%, transparent 100%), linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); -webkit-mask-composite: source-in;">
          <Image src={kkPhoto} alt="Ксения Котова" widths={[200, 400]} sizes="200px" loading="eager" fetchpriority="high" class="w-full h-full object-cover object-[50%_8%] opacity-65" />
        </div>
        <div class="text-center px-6 xl:px-10">
          <p class="font-accent italic text-dp-gold-ink text-base mb-3 tracking-wide">{home.heroQuote}</p>
          <h1 class="font-heading text-xl md:text-3xl font-bold text-parchment leading-tight mb-4">
            {home.duoLabel}<br/>{authorsData.ksenia.name},<br/>{authorsData.vasily.name}
          </h1>
          <GoldLine size="lg" class="mx-auto mb-4" />
          <p class="text-parchment/70 text-base leading-relaxed mb-7 max-w-xl mx-auto">
            {home.heroDescription}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/books" class="px-7 py-2.5 bg-dp-gold text-dp-dark font-body text-sm tracking-widest uppercase hover:bg-dp-copper transition-colors">{home.booksButton}</a>
            <a href="/about" class="px-7 py-2.5 border border-dp-gold/50 text-parchment/80 text-sm tracking-widest uppercase hover:border-dp-gold hover:text-parchment transition-colors">{home.aboutButton}</a>
          </div>
        </div>
        <div class="hidden xl:block h-72 pointer-events-none overflow-hidden self-center"
          style="mask-image: linear-gradient(to left, transparent 0%, black 25%, black 60%, transparent 100%), linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); mask-composite: intersect; -webkit-mask-image: linear-gradient(to left, transparent 0%, black 25%, black 60%, transparent 100%), linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%); -webkit-mask-composite: source-in;">
          <Image src={vzPhoto} alt="Василий Зеленков" widths={[200, 400]} sizes="200px" loading="eager" class="w-full h-full object-cover object-[50%_8%] opacity-65" />
        </div>
      </div>
    </div>
  </section>

  <!-- News banner + Progress -->
  {news.visible && (
    <div class="max-w-5xl mx-auto px-6 pt-6">
      <div class="mx-[30px] border border-dp-gold/30 bg-dp-gold/5 px-6 py-4">
        <p class="text-[9px] tracking-widest uppercase text-dp-gold-ink mb-3">{home.inProgress}</p>
        {newsHtml && (
          <div class="font-body text-sm text-dp-text leading-relaxed mb-4 [&>p]:mb-2 [&>p:last-child]:mb-0" set:html={newsHtml} />
        )}
        {visibleProgress.length > 0 && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
            {visibleProgress.map(item => {
              const pct = Math.round((item.current / item.total) * 100);
              const circumference = 2 * Math.PI * 36;
              const offset = circumference - (pct / 100) * circumference;
              return (
                <div class="flex flex-col items-center gap-1.5">
                  <div class="relative w-20 h-20" role="progressbar" aria-valuenow={pct} aria-valuemin={0} aria-valuemax={100} aria-label={`${item.title}: ${pct}%`}>
                    <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
                      <circle cx="50" cy="50" r="36" fill="none" stroke={PROGRESS_TRACK} stroke-width="10" />
                      <circle cx="50" cy="50" r="36" fill="none" stroke={PROGRESS_FILL} stroke-width="10"
                        stroke-dasharray={circumference}
                        stroke-dashoffset={offset}
                        stroke-linecap="round" />
                    </svg>
                    <span class="absolute inset-0 flex items-center justify-center text-xs font-body text-dp-text">
                      {pct}%
                    </span>
                  </div>
                  <span class="text-[9px] tracking-widest uppercase text-dp-muted text-center leading-tight">{item.title}</span>
                  <span class="text-[9px] tracking-widest uppercase text-dp-muted">{item.current}/{item.total} глав</span>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  )}

  <!-- С чего начать знакомство -->
  <StartHere />

  <!-- Covers Gallery -->
  <section class="max-w-5xl mx-auto px-6 pt-4 pb-2">
    <div class="flex items-center gap-4 mb-4">
      <div class="flex-1 h-px bg-dp-border"></div>
      <a href="/books" class="hover:text-dp-gold transition-colors"><h2 class="font-heading text-2xl md:text-3xl font-semibold whitespace-nowrap">{home.booksHeading}</h2></a>
      <div class="flex-1 h-px bg-dp-border"></div>
    </div>
    <p class="font-accent italic text-dp-muted text-base text-center mb-2">{home.everyStory}</p>
    <CoversGallery covers={covers} />
  </section>

  <!-- Divider -->
  <div class="max-w-5xl mx-auto px-6">
    <Divider />
  </div>

  <!-- Literary platforms -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <DecoratedBox class="max-w-2xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="font-heading text-2xl font-semibold">{home.litportalsHeading}</h2>
        <GoldLine class="mx-auto mt-4" />
      </div>
      <LitPortals ksenia={links.litportals.ksenia} vasily={links.litportals.vasily} />
    </DecoratedBox>
  </section>

  <!-- Divider -->
  <div class="max-w-5xl mx-auto px-6">
    <Divider />
  </div>

  <!-- Latest blog posts -->

<section class="max-w-5xl mx-auto px-6 pt-8 pb-16">

  <div class="mb-8">

    <a href="/blog" class="hover:text-dp-gold transition-colors"><h2 class="font-heading text-3xl font-semibold">{home.newsHeading}</h2></a>

    <GoldLine class="mt-4" />

  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    {blogPosts.map(post => {
      const coverSrc = post.data.cover ? findImage(post.data.cover) : undefined;
      return (
      <article class="border border-dp-border flex flex-col hover:border-dp-gold/50 transition-colors overflow-hidden">

        {coverSrc ? (
          <a href={`/blog/${post.slug}`} class="block aspect-[4/3] overflow-hidden">
            <Image
              src={coverSrc}
              alt={post.data.title}
              widths={[300, 600]}
              sizes="(max-width: 768px) 100vw, 300px"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </a>
        ) : (
          <a href={`/blog/${post.slug}`} class="block aspect-[4/3] bg-dp-dark flex items-center justify-center">
            <span class="text-parchment/20 text-5xl font-heading">{post.data.title.charAt(0)}</span>
          </a>
        )}

        <div class="p-6 flex flex-col gap-3 flex-1">

        <time class="text-xs tracking-widest uppercase text-dp-muted">

          {post.data.date.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}

        </time>

        <h3 class="font-heading text-lg font-semibold leading-tight">

          <a href={`/blog/${post.slug}`} class="hover:text-dp-gold transition-colors">{post.data.title}</a>

        </h3>

        <p class="text-sm text-dp-muted leading-relaxed flex-1">{post.data.excerpt}</p>

        <a href={`/blog/${post.slug}`} class="text-xs tracking-widest uppercase text-dp-gold-ink hover:text-dp-text transition-colors mt-1">

          Читать →

        </a>

        </div>

      </article>
      );
    })}

  </div>

</section>

</BaseLayout>
