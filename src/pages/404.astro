---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoldLine from '../components/GoldLine.astro';
import { loadDataFile } from '../lib/data';

const ui = loadDataFile<any>('src/data/ui.md', { notFound: {}, nav: [] });
const nf = ui.notFound ?? {};
const navLinks = ui.nav ?? [];
---
<BaseLayout title={nf.heading} description={nf.subheading} noindex={true}>
  <div class="max-w-5xl mx-auto px-6 pt-32 pb-24 text-center">
    <p class="font-heading text-8xl font-semibold text-dp-gold/30 mb-4">404</p>
    <GoldLine class="mx-auto mb-8" />
    <h1 class="font-heading text-2xl font-semibold mb-4">{nf.subheading}</h1>
    <p class="text-dp-muted text-sm mb-12 leading-relaxed">
      {nf.description}
    </p>
    <nav class="flex flex-wrap justify-center gap-4">
      {navLinks.map((link, i) => (
        <a href={link.href} class={`text-xs tracking-widest uppercase px-4 py-2 border ${i === 0 ? 'border-dp-gold/50 text-dp-gold-ink hover:border-dp-gold hover:text-dp-text' : 'border-dp-border text-dp-muted hover:border-dp-gold hover:text-dp-gold'} transition-colors`}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</BaseLayout>
