---
import GoldLine from './GoldLine.astro';

interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<header class="text-center mb-6">
  <h1 class="font-heading text-4xl md:text-5xl font-semibold">{title}</h1>
  <GoldLine class="mx-auto mt-4" />
  {subtitle && <p class="font-accent italic text-dp-muted text-base mt-2 leading-relaxed">{subtitle}</p>}
</header>
