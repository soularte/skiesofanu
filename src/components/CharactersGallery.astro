---
import { Image } from 'astro:assets';
import { findImage } from '../lib/images';
import Gallery from './Gallery.astro';
import { loadDataFile } from '../lib/data';

interface Props {
  characters: {
    name: string;
    role: string;
    description: string;
    photo?: string;
  }[];
  folder?: string;
}
const { characters, folder } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { aria: {} });
const aria = ui.aria ?? {};

function resolvePhoto(photo: string | undefined) {
  if (!photo) return undefined;
  const folderKey = folder ? `${folder}/${photo}` : photo;
  return findImage(folderKey) ?? findImage(photo);
}
---

<Gallery count={characters.length} prefix="chars" trackClass="gap-6 pb-4">
  <Fragment slot="mobile">
    {characters.map(char => {
          const photoImg = resolvePhoto(char.photo);
          const initials = char.name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]?.toUpperCase() ?? '').join('');
          return (
          <div class="w-full flex-shrink-0 flex justify-center px-4">
            <div class="flex flex-col" style="width: 250px;">
              <div class="border border-dp-border overflow-hidden" style="width: 250px; height: 350px;" data-lightbox-group="characters-mobile">
                {photoImg
                  ? <Image src={photoImg} alt={char.name} widths={[250, 500]} sizes="250px" loading="lazy" class="w-full h-full object-cover" />
                  : <div class="w-full h-full bg-dp-dark/30 flex flex-col items-center justify-center gap-2"><span class="font-heading text-3xl text-dp-gold/70">{initials || '—'}</span><span class="text-dp-muted text-xs tracking-wider text-center px-3">{char.name}</span></div>
                }
              </div>
              <div class="pt-3 pb-2">
                <p class="font-heading font-semibold text-sm leading-tight mb-1">{char.name}</p>
                {char.role && <p class="text-[10px] text-dp-gold-ink tracking-widest uppercase leading-tight mb-2">{char.role}</p>}
                {char.description && (
                  <div class="border-t border-dp-border/60 pt-2">
                    <p class="text-dp-muted text-[11px] leading-relaxed">{char.description}</p>
                  </div>
                )}
              </div>
            </div>
          </div>
          );
        })}
  </Fragment>
  <Fragment slot="desktop">
    {characters.map(char => {
        const photoImg = resolvePhoto(char.photo);
        const initials = char.name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]?.toUpperCase() ?? '').join('');
        return (
        <div class="flex-shrink-0 flex flex-col snap-start" style="width: 250px;">
          <div class="border border-dp-border overflow-hidden cursor-pointer hover:opacity-90 transition-opacity" style="width: 250px; height: 350px;" data-lightbox-group="characters">
            {photoImg
              ? <Image src={photoImg} alt={char.name} widths={[250, 500]} sizes="250px" loading="lazy" class="w-full h-full object-cover" />
              : <div class="w-full h-full bg-dp-dark/30 flex flex-col items-center justify-center gap-2"><span class="font-heading text-3xl text-dp-gold/70">{initials || '—'}</span><span class="text-dp-muted text-xs tracking-wider text-center px-3">{char.name}</span></div>
            }
          </div>
          <div class="pt-3 pb-2">
            <p class="font-heading font-semibold text-sm leading-tight mb-1">{char.name}</p>
            {char.role && <p class="text-[10px] text-dp-gold-ink tracking-widest uppercase leading-tight mb-2">{char.role}</p>}
            {char.description && (
              <div class="border-t border-dp-border/60 pt-2">
                <p class="text-dp-muted text-[11px] leading-relaxed">{char.description}</p>
              </div>
            )}
          </div>
        </div>
        );
      })}
  </Fragment>
</Gallery>
