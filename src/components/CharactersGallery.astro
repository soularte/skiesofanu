---
import { Image } from 'astro:assets';
import { findImage } from '../lib/images';
import GalleryArrow from './GalleryArrow.astro';
import { loadDataFile } from '../lib/data';

interface Props {
  characters: {
    name: string;
    role: string;
    description: string;
    photo?: string;
  }[];
  folder?: string;
}
const { characters, folder } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { aria: {} });
const aria = ui.aria ?? {};

function resolvePhoto(photo: string | undefined) {
  if (!photo) return undefined;
  const folderKey = folder ? `${folder}/${photo}` : photo;
  return findImage(folderKey) ?? findImage(photo);
}
---

<div class="relative">
  <!-- Mobile: one character at a time -->
  <div class="sm:hidden">
    <div id="chars-track-mobile" class="overflow-hidden relative">
      <div class="flex transition-transform duration-300" id="chars-slider">
        {characters.map(char => {
          const photoImg = resolvePhoto(char.photo);
          const initials = char.name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]?.toUpperCase() ?? '').join('');
          return (
          <div class="w-full flex-shrink-0 flex justify-center px-4">
            <div class="flex flex-col" style="width: 250px;">
              <div class="border border-dp-border overflow-hidden" style="width: 250px; height: 350px;" data-lightbox-group="characters-mobile">
                {photoImg
                  ? <Image src={photoImg} alt={char.name} widths={[250, 500]} sizes="250px" loading="lazy" class="w-full h-full object-cover" />
                  : <div class="w-full h-full bg-dp-dark/30 flex flex-col items-center justify-center gap-2"><span class="font-heading text-3xl text-dp-gold/70">{initials || '—'}</span><span class="text-dp-muted text-xs tracking-wider text-center px-3">{char.name}</span></div>
                }
              </div>
              <div class="pt-3 pb-2">
                <p class="font-heading font-semibold text-sm leading-tight mb-1">{char.name}</p>
                {char.role && <p class="text-[10px] text-dp-gold-ink tracking-widest uppercase leading-tight mb-2">{char.role}</p>}
                {char.description && (
                  <div class="border-t border-dp-border/60 pt-2">
                    <p class="text-dp-muted text-[11px] leading-relaxed">{char.description}</p>
                  </div>
                )}
              </div>
            </div>
          </div>
          );
        })}
      </div>
      <!-- Tap zones -->
      <button id="chars-mobile-prev" aria-label={aria.prev} class="absolute left-0 top-0 bottom-0 w-1/4 z-10"></button>
      <button id="chars-mobile-next" aria-label={aria.next} class="absolute right-0 top-0 bottom-0 w-1/4 z-10"></button>
    </div>
    {characters.length > 1 && (
      <div class="flex justify-center gap-2 mt-3">
        {characters.map((_, i) => (
          <button class="chars-dot w-2 h-2 rounded-full bg-dp-border transition-colors" data-index={i}></button>
        ))}
      </div>
    )}
  </div>

  <!-- Desktop: scrollable track -->
  <div class="hidden sm:block">
    <div
      id="chars-track"
      class="flex gap-6 overflow-x-auto select-none pb-4"
      style="scrollbar-width: none; -ms-overflow-style: none; scroll-snap-type: x mandatory;"
    >
      {characters.map(char => {
        const photoImg = resolvePhoto(char.photo);
        const initials = char.name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]?.toUpperCase() ?? '').join('');
        return (
        <div class="flex-shrink-0 flex flex-col snap-center" style="width: 250px;">
          <div class="border border-dp-border overflow-hidden cursor-pointer hover:opacity-90 transition-opacity" style="width: 250px; height: 350px;" data-lightbox-group="characters">
            {photoImg
              ? <Image src={photoImg} alt={char.name} widths={[250, 500]} sizes="250px" loading="lazy" class="w-full h-full object-cover" />
              : <div class="w-full h-full bg-dp-dark/30 flex flex-col items-center justify-center gap-2"><span class="font-heading text-3xl text-dp-gold/70">{initials || '—'}</span><span class="text-dp-muted text-xs tracking-wider text-center px-3">{char.name}</span></div>
            }
          </div>
          <div class="pt-3 pb-2">
            <p class="font-heading font-semibold text-sm leading-tight mb-1">{char.name}</p>
            {char.role && <p class="text-[10px] text-dp-gold-ink tracking-widest uppercase leading-tight mb-2">{char.role}</p>}
            {char.description && (
              <div class="border-t border-dp-border/60 pt-2">
                <p class="text-dp-muted text-[11px] leading-relaxed">{char.description}</p>
              </div>
            )}
          </div>
        </div>
        );
      })}
    </div>

    <!-- Left hover zone -->
    <GalleryArrow direction="left" id="chars-prev" />

    <!-- Right hover zone -->
    <GalleryArrow direction="right" id="chars-next" />
  </div>
</div>

<style>
  #chars-track::-webkit-scrollbar { display: none; }
  .chars-dot.active { background-color: #C9A84C; }
</style>

<script>
  import { initSlider } from '../lib/slider';
  initSlider({ prefix: 'chars', step: 280 });
</script>
