---
import { Image } from 'astro:assets';
import SeriesBadge from './SeriesBadge.astro';
import MarketplaceLinks from './MarketplaceLinks.astro';
import Gallery from './Gallery.astro';
import { loadDataFile } from '../lib/data';
import type { ImageMetadata } from 'astro';

interface Props {
  covers: {
    src: ImageMetadata;
    title: string;
    slug: string;
    extraBooks?: number;
    description?: string;
    marketplace?: boolean;
    links?: { url: string; label: string }[];
  }[];
}
const { covers } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { aria: {} });
const aria = ui.aria ?? {};
---

<Gallery count={covers.length} prefix="covers" trackClass="gap-6 overflow-y-clip pt-10 pb-4 px-4">
  <Fragment slot="mobile">
    {covers.map(cover => (
          <div class="w-full flex-shrink-0 flex justify-center px-4">
            <div class="flex flex-col" style="width: 200px;">
              <a href={`/books/${cover.slug}`} class="group block relative shadow-md" style="width: 200px;" draggable="false">
                <Image
                  src={cover.src}
                  alt={cover.title}
                  widths={[200, 400]}
                  sizes="200px"
                  loading="lazy"
                  draggable="false"
                  style="width: 200px; height: auto; display: block;"
                />
                <div class="absolute inset-0 bg-white/0 group-hover:bg-white/10 transition-colors duration-300"></div>
                <SeriesBadge count={cover.extraBooks ?? 0} />
              </a>
              <div class="pt-3">
                <a href={`/books/${cover.slug}`} class="font-heading font-semibold text-sm leading-tight hover:text-dp-gold-ink transition-colors">
                  {cover.title}
                </a>
                {cover.description && (
                  <p class="text-dp-muted text-xs leading-relaxed mt-1.5 cursor-default">{cover.description}</p>
                )}
                {cover.links && cover.links.length > 0 && (
                  <div class="mt-2">
                    <MarketplaceLinks links={cover.links} marketplace={cover.marketplace} />
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
  </Fragment>
  <Fragment slot="desktop">
    {covers.map(cover => (
        <div class="flex-shrink-0 flex flex-col snap-start transition-transform duration-300 hover:scale-105 hover:-translate-y-2" style="width: 200px;">
          <a href={`/books/${cover.slug}`} class="block relative shadow-md" style="width: 200px;" draggable="false">
            <Image
              src={cover.src}
              alt={cover.title}
              widths={[200, 400]}
              sizes="200px"
              loading="lazy"
              draggable="false"
              style="width: 200px; height: auto; display: block;"
            />
            <SeriesBadge count={cover.extraBooks ?? 0} />
          </a>
          <div class="pt-3">
            <a href={`/books/${cover.slug}`} class="font-heading font-semibold text-sm leading-tight hover:text-dp-gold-ink transition-colors">
              {cover.title}
            </a>
            {cover.description && (
              <p class="text-dp-muted text-xs leading-relaxed mt-1.5 cursor-default">{cover.description}</p>
            )}
            {cover.links && cover.links.length > 0 && (
              <div class="mt-2">
                <MarketplaceLinks links={cover.links} marketplace={cover.marketplace} />
              </div>
            )}
          </div>
        </div>
      ))}
  </Fragment>
</Gallery>
