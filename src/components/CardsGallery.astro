---
import Gallery from './Gallery.astro';
import { loadDataFile } from '../lib/data';

interface Props {
  images: string[];
}
const { images } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { aria: {} });
const aria = ui.aria ?? {};
---

<Gallery count={images.length} prefix="cards" trackClass="gap-4 py-2">
  <Fragment slot="mobile">
    {images.map(src => (
          <div class="w-full flex-shrink-0 flex justify-center px-4">
            <img src={src} alt={aria.promoCard} loading="lazy" draggable="false" width="248" height="350" class="h-[350px] w-auto shadow-lg" data-lightbox-group="cards-mobile" data-lightbox-src={src} />
          </div>
        ))}
  </Fragment>
  <Fragment slot="desktop">
    {images.map(src => (
        <img
          src={src}
          alt={aria.promoCard}
          loading="lazy"
          draggable="false"
          width="248"
          height="350"
          class="flex-shrink-0 h-[350px] w-auto shadow-lg snap-start cursor-pointer hover:opacity-90 transition-opacity"
          data-lightbox-group="cards"
          data-lightbox-src={src}
        />
      ))}
  </Fragment>
</Gallery>
