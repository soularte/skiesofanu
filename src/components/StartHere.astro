---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { findImage } from '../lib/images';
import { loadDataFile } from '../lib/data';

interface FirstData {
  enabled: boolean;
  title: string;
}
const firstData = loadDataFile<FirstData>('src/data/first.md', { enabled: true, title: 'С чего начать' });

const pathItems = firstData.enabled ? (await getCollection('paths')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)) : [];

const resolved = pathItems.map(item => ({
  label: item.data.title,
  slug: item.slug,
  img: findImage(item.data.cover),
}));
---

{firstData.enabled && (
<section class="max-w-5xl mx-auto px-6 pt-8 pb-4">
  <div class="text-center mb-8">
    <h2 class="font-heading text-3xl md:text-4xl font-semibold">{firstData.title}</h2>
  </div>

  <div class="relative border border-dp-gold/30 p-1 rounded-lg">
    <!-- Mobile: 2x2 grid -->
    <div class="grid grid-cols-2 gap-1 md:hidden rounded-md overflow-hidden">
      {resolved.map((item) => (
        <a
          href={`/paths/${item.slug}`}
          class="group relative overflow-hidden h-[200px]"
        >
          {item.img && (
            <Image
              src={item.img}
              alt={item.label}
              widths={[300, 600]}
              sizes="50vw"
              class="absolute inset-0 w-full h-full object-cover object-top transition-all duration-700 grayscale group-hover:grayscale-0 group-hover:scale-110"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-dp-dark/80 via-dp-dark/20 to-transparent transition-opacity duration-500 group-hover:opacity-40" />
          <div class="absolute inset-0 bg-dp-gold/0 group-hover:bg-dp-gold/10 transition-colors duration-300" />
          <div class="absolute inset-0 pointer-events-none start-here-shimmer" />
          <div class="absolute inset-0 flex items-center justify-center p-3">
            <span class="font-heading text-parchment text-sm font-semibold text-center drop-shadow-lg tracking-widest uppercase whitespace-pre-line transition-all duration-300 group-hover:-translate-y-1 group-hover:text-dp-gold">
              {item.label}
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Desktop: diagonal strip -->
    <div class="relative w-full h-[380px] hidden md:flex overflow-hidden rounded-md">
      {resolved.map((item, i) => (
        <a
          href={`/paths/${item.slug}`}
          class="group relative flex-1 overflow-hidden"
          style={`clip-path: polygon(${i === 0 ? '0%' : '15%'} 0%, 100% 0%, ${i === resolved.length - 1 ? '100%' : '85%'} 100%, 0% 100%); margin-left: ${i === 0 ? '0' : '-5%'}; z-index: ${i};`}
        >
          {item.img && (
            <Image
              src={item.img}
              alt={item.label}
              widths={[400, 800]}
              sizes="30vw"
              class="absolute inset-0 w-full h-full object-cover object-top transition-all duration-700 grayscale group-hover:grayscale-0 group-hover:scale-110"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-dp-dark/80 via-dp-dark/20 to-transparent transition-opacity duration-500 group-hover:opacity-40" />
          <div class="absolute inset-0 bg-dp-gold/0 group-hover:bg-dp-gold/10 transition-colors duration-300" />
          <div class="absolute inset-0 pointer-events-none start-here-shimmer" />
          <div class="absolute bottom-0 left-0 right-0 p-4 flex items-end justify-center">
            <span class="font-heading text-parchment text-base font-semibold text-center drop-shadow-lg tracking-widest uppercase whitespace-pre-line transition-all duration-300 group-hover:-translate-y-2 group-hover:text-dp-gold">
              {item.label}
            </span>
          </div>
          <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-8 h-0.5 bg-dp-gold/0 group-hover:bg-dp-gold transition-all duration-300 group-hover:w-12 mb-2" />
        </a>
      ))}
    </div>
  </div>
</section>
)}

<style is:global>
  .start-here-shimmer {
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.2) 45%,
      rgba(255, 255, 255, 0.35) 50%,
      rgba(255, 255, 255, 0.2) 55%,
      transparent 70%
    );
    background-size: 250% 100%;
    background-position: 200% 0;
  }
  a:hover .start-here-shimmer {
    animation: shimmer 0.8s ease-out forwards;
  }
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -50% 0; }
  }
</style>