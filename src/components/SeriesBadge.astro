---
interface Props {
  count: number;
}
const { count } = Astro.props;
const label = `Других книг в цикле: ${count}`;
---
{count > 0 && (
  <span
    class="series-badge"
    title={label}
    aria-label={label}
    data-series-extra={count}
  >
    <img class="ribbon" src="/images/ui/bookmark-ribbon.webp" width="320" height="120" alt="" aria-hidden="true" draggable="false" />
    <span class="ribbon-count" aria-hidden="true">+{count}</span>
  </span>
)}

<style>
  .series-badge {
    position: absolute;
    top: 50%;
    right: -5px;
    transform: translateY(-50%);
    z-index: 20;
    isolation: isolate;
    width: 80px;
    height: 30px;
    filter: drop-shadow(-1px 2px 2px rgb(26 26 46 / 24%));
    color: #493923;
    font: 400 14px/1 Georgia, serif;
    font-variant-numeric: tabular-nums;
  }
  .ribbon { display: block; width: 100%; height: 100%; pointer-events: none; user-select: none; }
  .series-badge::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(250 230 192 / 62%);
    mix-blend-mode: screen;
    mask: url('/images/ui/bookmark-ribbon.webp') center / 100% 100% no-repeat;
    -webkit-mask: url('/images/ui/bookmark-ribbon.webp') center / 100% 100% no-repeat;
    pointer-events: none;
  }
  .ribbon-count { position: absolute; z-index: 1; top: 49%; left: 47%; transform: translate(-50%, -50%); text-shadow: 0 1px 1px rgb(250 246 240 / 35%); }
</style>
