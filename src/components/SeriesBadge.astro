---
interface Props {
  count: number;
}
const { count } = Astro.props;
const label = `Других книг в цикле: ${count}`;
---
{count > 0 && (
  <span
    class="series-badge"
    title={label}
    aria-label={label}
    data-series-extra={count}
  >+{count}</span>
)}

<style>
  .series-badge {
    position: absolute;
    top: 50%;
    right: 8px;
    transform: translateY(-50%);
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: rgb(250 246 240 / 32%);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    color: #7A5E1A;
    font: 500 11px/1 Inter, system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    transition: background-color 180ms ease;
  }
  :global(a:hover) .series-badge,
  :global(a:focus-visible) .series-badge {
    background: rgb(250 246 240 / 82%);
  }
  @media (prefers-reduced-motion: reduce) {
    .series-badge { transition: none; }
  }
</style>
