---
import { loadDataFile } from '../lib/data';

interface Props {
  siteName: string;
  siteTagline?: string;
}

const { siteName, siteTagline } = Astro.props;

const uiData = loadDataFile<any>('src/data/ui.md', { nav: [], aria: {} });
const navLinks = uiData.nav ?? [];
const aria = uiData.aria ?? {};

const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
function currentSection(href: string): 'page' | 'location' | undefined {
  const path = normalizePath(href);
  if (currentPath === path) return 'page';
  if (path !== '/' && currentPath.startsWith(`${path}/`)) return 'location';
  return undefined;
}
---
<header class="border-b border-dp-border bg-parchment/90 backdrop-blur-sm">
  <div class="max-w-5xl mx-auto px-6 pt-4 pb-[26px] flex items-center justify-between">
    <a href="/" class="focus-ring flex flex-col leading-tight hover:text-dp-gold transition-colors group">
      <span class="font-heading text-2xl font-semibold tracking-wide text-dp-text group-hover:text-dp-gold transition-colors">{siteName}</span>
      {siteTagline && <span class="text-xs tracking-widest uppercase text-dp-muted mt-0.5">{siteTagline}</span>}
    </a>
    <nav class="hidden md:flex items-center gap-8" aria-label={aria.mainNav}>
      {navLinks.map(link => (
        <a
          href={link.href}
          aria-current={currentSection(link.href)}
          class={`focus-ring text-sm tracking-widest uppercase transition-colors ${
            currentSection(link.href)
              ? 'text-dp-gold-ink border-b border-dp-gold pb-0.5'
              : 'text-dp-muted hover:text-dp-text'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <!-- Mobile menu button -->
    <button id="menu-toggle" class="focus-ring md:hidden text-dp-muted hover:text-dp-text" aria-label={aria.openMenu} data-open-label={aria.openMenu} data-close-label={aria.closeMenu ?? 'Закрыть меню'} aria-expanded="false" aria-controls="mobile-menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-dp-border">
    <nav class="max-w-5xl mx-auto px-6 py-4 flex flex-col gap-4" aria-label={aria.mobileNav}>
      {navLinks.map(link => (
        <a
          href={link.href}
          data-mobile-link
          aria-current={currentSection(link.href)}
          class={`focus-ring self-start text-sm tracking-widest uppercase transition-colors ${currentSection(link.href)
            ? 'text-dp-gold-ink border-b border-dp-gold pb-0.5'
            : 'text-dp-muted hover:text-dp-text'}`}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const setMenuOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? 'Меню');
  };
  const closeMenu = () => setMenuOpen(false);
  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
    event.preventDefault();
    closeMenu();
    toggle.focus({ preventScroll: true });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-mobile-link]').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
