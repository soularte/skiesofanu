---
import Section from './Section.astro';
import { loadDataFile } from '../../lib/data';

interface Props {
  id?: string;
  reviews: Array<{ text: string; author: string }>;
}
const { reviews, id } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { bookSections: {} });
---
<Section id={id} title={ui.bookSections.reviews}>
  <div class="reviews-container">
  <div class="reviews-grid">
    {reviews.map(review => (
      <div class="border border-dp-border p-6 flex flex-col gap-4">
        <p class="text-dp-text leading-relaxed flex-1">{review.text}</p>
        <p class="text-dp-muted text-xs tracking-widest uppercase text-right">&mdash; {review.author}</p>
      </div>
    ))}
  </div>
  </div>
</Section>

<style>
  .reviews-container { container-type: inline-size; }
  .reviews-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  @container (min-width: 60rem) {
    .reviews-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
