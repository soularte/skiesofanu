---
import Section from './Section.astro';

interface Props {
  trailer: {
    visible?: boolean;
    file: string;
    orientation?: 'horizontal' | 'vertical';
  };
}
const { trailer } = Astro.props;
---
<Section title="Буктрейлер">
  <div class="flex justify-center">
    <div class={trailer.orientation === 'vertical' ? 'max-h-[600px] w-auto max-w-xs' : 'w-full max-w-2xl'}>
      <video
        src={`/videos/${trailer.file}`}
        controls
        preload="none"
        class="w-full block"
        style="background:#1A1A2E;"
      />
    </div>
  </div>
</Section>
