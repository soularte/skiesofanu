---
import Section from './Section.astro';
import { loadDataFile } from '../../lib/data';
import type { CollectionEntry } from 'astro:content';
interface Props {
  id?: string;
  trailer: NonNullable<CollectionEntry<'books'>['data']['booktrailer']>;
}
const { trailer, id } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { bookSections: {} });
let embedUrl: string | undefined;
if (trailer.url) {
  const source = new URL(trailer.url);
  const videoId = source.pathname.split('/').filter(Boolean).at(-1);
  const embed = new URL(`https://rutube.ru/play/embed/${videoId}/`);
  const accessKey = source.searchParams.get('p');
  if (accessKey) embed.searchParams.set('p', accessKey);
  embedUrl = embed.href;
}
const pageURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const videoSchema = trailer.seo ? {
  '@context': 'https://schema.org', '@type': 'VideoObject',
  '@id': pageURL + '#booktrailer-video',
  name: trailer.seo.name, description: trailer.seo.description,
  thumbnailUrl: trailer.seo.thumbnailUrl, uploadDate: trailer.seo.uploadDate,
  duration: trailer.seo.duration, inLanguage: 'ru',
  ...(trailer.seo.datePublished ? { datePublished: trailer.seo.datePublished } : {}),
  ...(embedUrl ? { embedUrl } : {}),
  ...(trailer.file ? { contentUrl: new URL('/videos/' + trailer.file, pageURL).href } : {}),
  isPartOf: { '@type': 'WebPage', url: pageURL },
} : undefined;
---
{videoSchema && <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />}
<Section id={id} title={ui.bookSections.booktrailer}>
  <div class="flex justify-center">
    <div class:list={['trailer-player', { vertical: trailer.orientation === 'vertical' }]}>
      {embedUrl ? <iframe
        src={embedUrl}
        title="Буктрейлер — RUTUBE"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; fullscreen"
        allowfullscreen
      /> : trailer.file && <video src={`/videos/${trailer.file}`} controls preload="none" />}
    </div>
  </div>
</Section>
<style>
  .trailer-player { width: 100%; max-width: 42rem; aspect-ratio: 16 / 9; background: #1A1A2E; }
  .trailer-player.vertical { max-width: min(20rem, 100%); aspect-ratio: 9 / 16; }
  iframe, video { display: block; width: 100%; height: 100%; border: 0; }
</style>
