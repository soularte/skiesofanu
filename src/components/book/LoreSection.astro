---
import Section from './Section.astro';
import TagChip from '../TagChip.astro';
import TagFilter from '../TagFilter.astro';
import { loadDataFile } from '../../lib/data';

interface Props {
  items: Array<{
    slug: string;
    data: {
      title: string;
      excerpt: string;
      cover?: string;
      tags?: string[];
    };
  }>;
  bookSlug: string;
}

const { items, bookSlug } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { bookSections: {} });

const allTags = [...new Set(items.flatMap(item => item.data.tags ?? []))].sort();
---

<Section title={ui.bookSections.lore}>
  {allTags.length > 0 && (
    <TagFilter tags={allTags} group="lore" class="mb-6" />
  )}

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="lore-grid">
    {items.map(item => (
      <a href={`/books/${bookSlug}/lore/${item.slug}`}
         class="lore-card group block border border-dp-border rounded-sm overflow-hidden hover:border-dp-gold/50 transition-colors"
         data-tags={JSON.stringify(item.data.tags ?? [])}>
        {item.data.cover && (
          <div class="aspect-[4/3] overflow-hidden">
            <img src={item.data.cover} alt={item.data.title}
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
        )}
        <div class="p-4">
          <h3 class="font-heading text-lg font-semibold group-hover:text-dp-gold transition-colors">
            {item.data.title}
          </h3>
          <p class="text-sm text-dp-muted mt-1 leading-relaxed line-clamp-2">
            {item.data.excerpt}
          </p>
          {item.data.tags && item.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1 mt-3">
              {item.data.tags.map(tag => <TagChip tag={tag} />)}
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
</Section>

<script>
  document.querySelector('[data-filter-group="lore"]')?.addEventListener('filter-change', (e: Event) => {
    const tag = (e as CustomEvent).detail.tag;

    document.querySelectorAll('.lore-card').forEach(card => {
      const link = card as HTMLAnchorElement;
      const baseHref = link.href.split('?')[0];
      link.href = tag !== 'all' ? `${baseHref}?tag=${encodeURIComponent(tag)}` : baseHref;

      if (tag === 'all') {
        link.style.display = '';
        return;
      }
      const tags: string[] = JSON.parse(link.getAttribute('data-tags') || '[]');
      link.style.display = tags.includes(tag) ? '' : 'none';
    });
  });
</script>
