---
import Section from './Section.astro';
import CharactersGallery from '../CharactersGallery.astro';
import { loadDataFile } from '../../lib/data';
import type { CollectionEntry } from 'astro:content';

type BookData = CollectionEntry<'books'>['data'];

interface Props {
  characters: NonNullable<BookData['characters']>;
  folder?: string;
}
const { characters, folder } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { bookSections: {} });
---
<Section title={ui.bookSections.characters}>
  <CharactersGallery characters={characters} folder={folder} />
</Section>
