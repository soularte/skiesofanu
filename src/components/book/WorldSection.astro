---
import Section from './Section.astro';
import SectionLink from '../SectionLink.astro';

interface Props {
  world: string;
  maps?: Array<{ label: string; url: string }>;
}
const { world, maps } = Astro.props;
---
<Section title="Мир" tightHeader>
  <div class="mb-4 space-y-4">
    {world.split('\n\n').filter((p: string) => p.trim()).map((para: string) => (
      <p class="text-dp-text leading-relaxed">{para.trim()}</p>
    ))}
  </div>
  {maps && maps.length > 0 && (
    <div class="flex flex-wrap gap-3">
      {maps.map(m => <SectionLink href={m.url} label={m.label} />)}
    </div>
  )}
</Section>
