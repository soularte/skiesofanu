---
import Section from './Section.astro';
import { loadDataFile } from '../../lib/data';

interface Props {
  world: string;
}
const { world } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { bookSections: {} });
---
<Section title={ui.bookSections.world} tightHeader>
  <div class="mb-4 space-y-4">
    {world.split('\n\n').filter((p: string) => p.trim()).map((para: string) => (
      <p class="text-dp-text leading-relaxed">{para.trim()}</p>
    ))}
  </div>
</Section>
