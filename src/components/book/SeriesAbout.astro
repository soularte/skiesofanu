---
import Section from './Section.astro';
import GenreChip from '../GenreChip.astro';
import { loadDataFile } from '../../lib/data';
import type { CollectionEntry } from 'astro:content';

type BookData = CollectionEntry<'books'>['data'];

interface Props {
  data: BookData;
}
const { data } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { bookSections: {} });
---
<Section title={`${ui.bookSections.seriesAbout} \u00ab${data.series}\u00bb`} tightHeader>
  {data.seriesDescription && (
    <div class="mb-4 space-y-4">
      {data.seriesDescription.split('\n\n').filter((p: string) => p.trim()).map((para: string) => (
        <p class="text-dp-text leading-relaxed">{para.trim()}</p>
      ))}
    </div>
  )}
  {data.links && data.links.length > 0 && (
    <div class="flex flex-wrap items-baseline gap-2 mb-8">
      <span class="text-xs tracking-widest uppercase text-dp-muted shrink-0">{ui.bookSections.readOn}</span>
      {data.links.map(link => (
        <a href={link.url} target="_blank" rel="noopener noreferrer"
          class="text-[10px] font-body tracking-widest px-1.5 py-0.5 border border-dp-gold/50 text-dp-gold-ink hover:border-dp-gold hover:text-dp-text transition-colors">
          {link.label}
        </a>
      ))}
    </div>
  )}
  {data.readingOrder && data.readingOrder.length > 0 && (
    <div>
      <h3 class="font-heading text-lg font-semibold mb-4 text-dp-text">{ui.bookSections.readingOrder}</h3>
      <div class="max-w-2xl">
        <ol class="space-y-3">
          {data.readingOrder.map((item, i) => (
            <li class="flex gap-3 text-dp-text items-baseline">
              <span class="text-dp-gold/60 leading-tight w-5 shrink-0">{i + 1}</span>
              <span class="flex flex-wrap items-baseline gap-1.5">
                <span>{item.title}</span>
                {item.labels && item.labels.map(label => <GenreChip label={label} />)}
              </span>
            </li>
          ))}
        </ol>
      </div>
      {data.readingMap && (
        <div class="mt-6">
          <a href={data.readingMap.url} class="text-dp-gold-ink hover:text-dp-text transition-colors underline underline-offset-4 text-sm">{data.readingMap.label}</a>
        </div>
      )}
    </div>
  )}
</Section>
