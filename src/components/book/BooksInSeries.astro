---
import Section from './Section.astro';
import PublicationNote from './PublicationNote.astro';
import MarketplaceLinks from '../MarketplaceLinks.astro';
import GenreChip from '../GenreChip.astro';
import GoldLine from '../GoldLine.astro';
import ZoomableCover from '../ZoomableCover.astro';
import { findImage } from '../../lib/images';
import { loadDataFile } from '../../lib/data';
import type { CollectionEntry } from 'astro:content';

type Book = NonNullable<CollectionEntry<'books'>['data']['books']>[number];

interface Props {
  id?: string;
  books: Book[];
}
const { books, id } = Astro.props;
const ui = loadDataFile<any>('src/data/ui.md', { bookSections: {} });
---
<Section id={id} title={ui.bookSections.booksInSeries}>
  <div class="space-y-10">
    {books.map((b, i) => {
      const bCover = findImage(b.cover);
      return (
        <article id={`book-${i + 1}`} class={`flex flex-col items-center sm:items-start sm:flex-row gap-8 scroll-mt-32 ${i % 2 === 1 ? 'sm:flex-row-reverse' : ''}`}>
          <div class={`flex-shrink-0 flex flex-col gap-4 items-center sm:items-start ${i % 2 === 1 ? 'sm:items-end' : ''}`}>
            {bCover && (
              <ZoomableCover src={bCover} title={b.title} group="series-covers" height={350} />
            )}
            {b.links && b.links.length > 0 && (
              <div class={`flex justify-center ${i % 2 === 1 ? 'sm:justify-end' : 'sm:justify-start'}`}>
                <MarketplaceLinks links={b.links} marketplace={b.marketplace} />
              </div>
            )}
          </div>
          <div class="flex-1">
            <h3 class="font-heading text-2xl md:text-3xl font-semibold mb-2">{b.title}</h3>
            <GoldLine size="sm" class="mb-4" />
            {b.genres && b.genres.length > 0 && (
              <div class="flex flex-wrap gap-1 mb-4">
                {b.genres.map((g: string) => <GenreChip label={g} />)}
              </div>
            )}
            {b.logline && (
              <p class="font-accent italic text-dp-gold-ink text-base mb-4 leading-relaxed">{b.logline}</p>
            )}
            {b.description && (
              <div class="space-y-3">
                {b.description.split('\n\n').filter((p: string) => p.trim()).map((para: string) => (
                  <p class="text-dp-text leading-relaxed">{para.trim()}</p>
                ))}
              </div>
            )}
            {b.printEdition && <PublicationNote>
              Книга выходила на бумаге в составе издания <a href={b.printEdition.bibliographyUrl} class="underline underline-offset-4 hover:text-dp-text">«{b.printEdition.title}»</a>.
            </PublicationNote>}
          </div>
        </article>
      );
    })}
  </div>
</Section>

<style>
  article[id] { scroll-margin-top: var(--page-anchor-offset, 8rem); }
</style>
