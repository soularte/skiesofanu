---
import Section from './Section.astro';
import MarketplaceLinks from '../MarketplaceLinks.astro';
import GenreChip from '../GenreChip.astro';
import GoldLine from '../GoldLine.astro';
import { Image } from 'astro:assets';
import { findImage } from '../../lib/images';
import type { CollectionEntry } from 'astro:content';

type Book = NonNullable<CollectionEntry<'books'>['data']['books']>[number];

interface Props {
  books: Book[];
}
const { books } = Astro.props;
---
<Section title="Книги цикла">
  <div class="space-y-10">
    {books.map((b, i) => {
      const bCover = findImage(b.cover);
      return (
        <article class={`flex flex-col items-center sm:items-start sm:flex-row gap-8 ${i % 2 === 1 ? 'sm:flex-row-reverse' : ''}`}>
          <div class={`flex-shrink-0 flex flex-col gap-4 items-center sm:items-start ${i % 2 === 1 ? 'sm:items-end' : ''}`}>
            {bCover && (
              <div class="relative">
                <div class="absolute -bottom-2 -right-2 w-full h-full border border-dp-gold/30 pointer-events-none -z-10"></div>
                <Image src={bCover} alt={b.title} widths={[250, 500]} sizes="250px" loading="lazy" class="h-[350px] w-auto relative cursor-pointer" data-lightbox-group="series-covers" />
              </div>
            )}
            {b.links && b.links.length > 0 && (
              <div class={`w-[200px] justify-center sm:justify-start ${i % 2 === 1 ? 'sm:justify-end' : ''}`}>
                <MarketplaceLinks links={b.links} marketplace={b.marketplace} />
              </div>
            )}
          </div>
          <div class="flex-1">
            <h3 class="font-heading text-2xl md:text-3xl font-semibold mb-2">{b.title}</h3>
            <GoldLine size="sm" class="mb-4" />
            {b.genres && b.genres.length > 0 && (
              <div class="flex flex-wrap gap-1 mb-4">
                {b.genres.map((g: string) => <GenreChip label={g} />)}
              </div>
            )}
            {b.logline && (
              <p class="font-accent italic text-dp-gold-ink text-base mb-4 leading-relaxed">{b.logline}</p>
            )}
            {b.description && (
              <div class="space-y-3">
                {b.description.split('\n\n').filter((p: string) => p.trim()).map((para: string) => (
                  <p class="text-dp-text leading-relaxed">{para.trim()}</p>
                ))}
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>
</Section>
