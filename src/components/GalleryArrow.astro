---
interface Props {
  direction: 'left' | 'right';
  id: string;
  mobile?: boolean;
}
const { direction, id, mobile = false } = Astro.props;
const isLeft = direction === 'left';
const path = isLeft ? 'M15 19l-7-7 7-7' : 'M9 5l7 7-7 7';
const posClass = isLeft ? 'left-0' : 'right-0';
---
<button
  type="button"
  id={id}
  aria-label={isLeft ? 'Назад' : 'Вперёд'}
  class={`absolute ${posClass} -translate-y-1/2 w-[52px] h-[52px] flex items-center justify-center ${mobile ? 'opacity-100' : 'opacity-0 hover:opacity-100 focus-visible:opacity-100'} transition-opacity duration-300 z-10 cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-dp-gold-ink focus-visible:outline-offset-2`}
  style={mobile ? 'top: var(--gallery-arrow-top, 175px);' : 'top: 50%;'}
>
  <span class="w-9 h-9 flex items-center justify-center rounded bg-white/60 shadow pointer-events-none">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-dp-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d={path} />
    </svg>
  </span>
</button>
